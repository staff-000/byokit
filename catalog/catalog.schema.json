{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "auth": {
            "enum": [
              "required",
              "optional",
              "none"
            ]
          },
          "deployment": {
            "enum": [
              "hosted",
              "local",
              "self-hosted"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "auth",
          "deployment"
        ]
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "openWeights": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "commercialUse": {
            "enum": [
              "allowed",
              "restricted",
              "unknown"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "size": {
            "type": "object",
            "properties": {
              "totalParameters": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "activeParameters": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "architecture": {
                "enum": [
                  "dense",
                  "moe",
                  "unknown"
                ]
              }
            },
            "required": []
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "name",
          "openWeights",
          "commercialUse",
          "license",
          "tags"
        ]
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "providerIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "providerIds"
        ]
      }
    },
    "offerings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "providerId": {
            "type": "string",
            "minLength": 1
          },
          "modelId": {
            "type": "string",
            "minLength": 1
          },
          "apiModelId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "deployment": {
            "enum": [
              "hosted",
              "local",
              "self-hosted"
            ]
          },
          "modalities": {
            "type": "object",
            "properties": {
              "input": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "enum": [
                    "text",
                    "image",
                    "audio",
                    "video",
                    "embedding"
                  ]
                }
              },
              "output": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "enum": [
                    "text",
                    "image",
                    "audio",
                    "video",
                    "embedding"
                  ]
                }
              }
            },
            "required": []
          },
          "limits": {
            "type": "object",
            "properties": {
              "context": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "input": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "output": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "contextAccounting": {
                "enum": [
                  "combined",
                  "input-only",
                  "unknown"
                ]
              }
            },
            "required": []
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "supported",
                    "unsupported",
                    "conditional",
                    "unknown"
                  ]
                },
                "source": {
                  "type": "string"
                },
                "reviewedAt": {
                  "type": "string"
                },
                "details": {
                  "type": "object"
                }
              }
            }
          },
          "price": {
            "type": "object",
            "properties": {
              "currency": {
                "type": "string",
                "minLength": 1
              },
              "input": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "output": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "cacheRead": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "cacheWrite": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            },
            "required": []
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lifecycleEvidence": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "LIVE",
                  "OUTDATED",
                  "UNCERTAIN"
                ]
              },
              "source": {
                "type": "string",
                "pattern": "^https://[^/]+"
              },
              "checkedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
              },
              "basis": {
                "enum": [
                  "provider",
                  "catalog-listing"
                ]
              }
            },
            "required": [
              "status",
              "source",
              "checkedAt"
            ],
            "additionalProperties": false
          },
          "popularityEvidence": {
            "type": "object",
            "properties": {
              "metric": {
                "enum": [
                  "requests",
                  "tokens",
                  "downloads"
                ]
              },
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "population": {
                "type": "integer",
                "minimum": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "pattern": "^https://[^/]+"
              },
              "windowStart": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
              },
              "windowEnd": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
              }
            },
            "required": [
              "metric",
              "rank",
              "population",
              "scope",
              "source",
              "windowStart",
              "windowEnd"
            ],
            "additionalProperties": false
          },
          "releaseDate": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "providerId",
          "modelId",
          "apiModelId",
          "name",
          "deployment",
          "modalities",
          "limits",
          "features",
          "price",
          "tags"
        ]
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "light": {
            "type": "string",
            "minLength": 1
          },
          "dark": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "light",
          "source"
        ]
      }
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "offeringId",
          "contributor",
          "checkedAt",
          "result",
          "checks",
          "evidence",
          "adapter"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "offeringId": {
            "type": "string",
            "minLength": 1
          },
          "contributor": {
            "type": "string",
            "pattern": "^github:[A-Za-z0-9-]+$"
          },
          "checkedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
          },
          "result": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "textGeneration",
                "functionCalling",
                "parallelTools",
                "forcedToolChoice",
                "strictToolSchema",
                "promptCaching",
                "jsonMode",
                "jsonSchema",
                "strictJsonSchema",
                "systemMessages",
                "developerMessages",
                "thinking",
                "thinkingDisable",
                "thinkingBudget",
                "thinkingEffort"
              ]
            }
          },
          "evidence": {
            "type": "string",
            "pattern": "^https://"
          },
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "providers",
    "models",
    "families",
    "offerings",
    "presets"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "byokit catalog v1"
}
