{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "auth": {
            "enum": ["required", "optional", "none"]
          },
          "deployment": {
            "enum": ["hosted", "local", "self-hosted"]
          }
        },
        "required": ["id", "name", "auth", "deployment"]
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "openWeights": {
            "type": ["boolean", "null"]
          },
          "commercialUse": {
            "enum": ["allowed", "restricted", "unknown"]
          },
          "license": {
            "type": ["string", "null"]
          },
          "size": {
            "type": "object",
            "properties": {
              "totalParameters": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "activeParameters": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "architecture": {
                "enum": ["dense", "moe", "unknown"]
              }
            },
            "required": []
          },
          "speciality": {
            "enum": [
              "general",
              "cybersecurity",
              "music",
              "safety",
              "embedding",
              "agent",
              "translation",
              "audio",
              "image",
              "video",
              "coding",
              "unknown"
            ]
          },
          "tier": {
            "enum": ["flagship", "workhorse", "flash", "lite", "mini", "unknown"]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "creatorId": {
            "type": ["string", "null"],
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "openWeights",
          "commercialUse",
          "license",
          "speciality",
          "tier",
          "tags"
        ]
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "providerIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "offeringIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": ["id", "providerIds"]
      }
    },
    "offerings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "providerId": {
            "type": "string",
            "minLength": 1
          },
          "modelId": {
            "type": "string",
            "minLength": 1
          },
          "apiModelId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "deployment": {
            "enum": ["hosted", "local", "self-hosted"]
          },
          "modalities": {
            "type": "object",
            "properties": {
              "input": {
                "type": ["array", "null"],
                "items": {
                  "enum": ["text", "image", "audio", "video", "embedding", "pdf"]
                }
              },
              "output": {
                "type": ["array", "null"],
                "items": {
                  "enum": ["text", "image", "audio", "video", "embedding", "pdf"]
                }
              }
            },
            "required": []
          },
          "limits": {
            "type": "object",
            "properties": {
              "context": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "input": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "output": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "contextAccounting": {
                "enum": ["combined", "input-only", "unknown"]
              }
            },
            "required": []
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["status"],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": ["supported", "unsupported", "conditional", "unknown"]
                },
                "source": {
                  "type": "string"
                },
                "reviewedAt": {
                  "type": "string"
                },
                "details": {
                  "type": "object"
                }
              }
            }
          },
          "price": {
            "type": "object",
            "properties": {
              "currency": {
                "type": "string",
                "minLength": 1
              },
              "input": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "output": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "cacheRead": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "cacheWrite": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "unit": {
                "const": "per-million-tokens"
              },
              "inputAudio": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "outputAudio": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "reasoning": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "tiers": {
                "type": "array"
              }
            },
            "required": []
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lifecycleEvidence": {
            "type": "object",
            "properties": {
              "status": {
                "enum": ["LIVE", "OUTDATED", "UNCERTAIN"]
              },
              "source": {
                "type": "string",
                "pattern": "^https://[^/]+"
              },
              "checkedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
              },
              "basis": {
                "enum": ["provider", "catalog-listing"]
              }
            },
            "required": ["status", "source", "checkedAt"],
            "additionalProperties": false
          },
          "popularityEvidence": {
            "type": "object",
            "properties": {
              "metric": {
                "enum": ["requests", "tokens", "downloads"]
              },
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "population": {
                "type": "integer",
                "minimum": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "pattern": "^https://[^/]+"
              },
              "windowStart": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
              },
              "windowEnd": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
              }
            },
            "required": [
              "metric",
              "rank",
              "population",
              "scope",
              "source",
              "windowStart",
              "windowEnd"
            ],
            "additionalProperties": false
          },
          "releaseDate": {
            "type": ["string", "null"],
            "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
          },
          "connection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["baseUrl", "protocol"],
            "properties": {
              "baseUrl": {
                "type": "string",
                "pattern": "^https?://"
              },
              "protocol": {
                "enum": ["openai-compatible", "claude", "gemini", "ollama"]
              }
            }
          },
          "callSupport": {
            "type": "object",
            "required": ["textGeneration", "reason"],
            "properties": {
              "textGeneration": {
                "type": "boolean"
              },
              "reason": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": false
          },
          "lastUpdated": {
            "type": ["string", "null"],
            "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
          },
          "type": {
            "type": "string"
          },
          "speciality": {
            "enum": [
              "general",
              "cybersecurity",
              "music",
              "safety",
              "embedding",
              "agent",
              "translation",
              "audio",
              "image",
              "video",
              "coding",
              "unknown"
            ]
          },
          "tier": {
            "enum": ["flagship", "workhorse", "flash", "lite", "mini", "unknown"]
          },
          "releaseChannel": {
            "enum": ["stable", "preview", "experimental", "unknown"]
          }
        },
        "required": [
          "id",
          "providerId",
          "modelId",
          "apiModelId",
          "name",
          "deployment",
          "modalities",
          "limits",
          "features",
          "price",
          "speciality",
          "tier",
          "tags"
        ]
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "light": {
            "type": "string",
            "minLength": 1
          },
          "dark": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "light", "source"]
      }
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "offeringId",
          "contributor",
          "checkedAt",
          "result",
          "checks",
          "evidence",
          "adapter"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "offeringId": {
            "type": "string",
            "minLength": 1
          },
          "contributor": {
            "type": "string",
            "pattern": "^github:[A-Za-z0-9-]+$"
          },
          "checkedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
          },
          "result": {
            "enum": ["passed", "failed"]
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "textGeneration",
                "functionCalling",
                "parallelTools",
                "forcedToolChoice",
                "strictToolSchema",
                "promptCaching",
                "jsonMode",
                "jsonSchema",
                "strictJsonSchema",
                "systemMessages",
                "developerMessages",
                "thinking",
                "thinkingDisable",
                "thinkingBudget",
                "thinkingEffort"
              ]
            }
          },
          "evidence": {
            "type": "string",
            "pattern": "^https://"
          },
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          },
          "tokensPerSecond": {
            "type": "number",
            "minimum": 0
          },
          "timeToFirstTokenMs": {
            "type": "number",
            "minimum": 0
          },
          "assessment": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attempt", "checks"],
            "properties": {
              "attempt": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "outcome",
                  "reason",
                  "scope",
                  "certainty",
                  "source",
                  "classifierVersion",
                  "retry"
                ],
                "properties": {
                  "outcome": {
                    "enum": ["succeeded", "partial", "blocked", "inconclusive"]
                  },
                  "reason": {
                    "enum": [
                      null,
                      "invalid_credentials",
                      "quota_exhausted",
                      "rate_limited",
                      "access_denied",
                      "region_restricted",
                      "policy_restricted",
                      "model_not_found_or_inaccessible",
                      "invalid_request",
                      "unsupported_operation",
                      "provider_unavailable",
                      "network_error",
                      "timeout",
                      "invalid_response",
                      "empty_response",
                      "unknown"
                    ]
                  },
                  "scope": {
                    "enum": [
                      "account",
                      "model",
                      "provider",
                      "region",
                      "request",
                      "client",
                      "unknown"
                    ]
                  },
                  "certainty": {
                    "enum": ["explicit", "inferred", "unknown"]
                  },
                  "source": {
                    "enum": ["provider_code", "http_status", "client_error"]
                  },
                  "classifierVersion": {
                    "const": "1"
                  },
                  "httpStatus": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  },
                  "retry": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["action", "afterSeconds"],
                    "properties": {
                      "action": {
                        "enum": [
                          "none",
                          "check_credentials",
                          "check_billing",
                          "retry_later",
                          "check_limits",
                          "check_model_access",
                          "check_supported_locations",
                          "review_policy",
                          "check_model_id_and_access",
                          "check_operation",
                          "check_settings",
                          "check_network",
                          "review_response",
                          "review_diagnostics"
                        ]
                      },
                      "afterSeconds": {
                        "type": ["integer", "null"],
                        "minimum": 0,
                        "maximum": 604800
                      }
                    }
                  }
                }
              },
              "checks": {
                "type": "object",
                "required": ["textGeneration", "speed"],
                "additionalProperties": false,
                "properties": {
                  "textGeneration": {
                    "enum": ["passed", "blocked", "inconclusive", "not_run"]
                  },
                  "speed": {
                    "enum": ["passed", "blocked", "inconclusive", "not_run"]
                  }
                }
              },
              "phases": {
                "type": "array",
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["phase", "attempt"],
                  "properties": {
                    "phase": {
                      "enum": ["baseline", "generation"]
                    },
                    "attempt": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "outcome",
                        "reason",
                        "scope",
                        "certainty",
                        "source",
                        "classifierVersion",
                        "retry"
                      ],
                      "properties": {
                        "outcome": {
                          "enum": [
                            "succeeded",
                            "partial",
                            "blocked",
                            "inconclusive",
                            "canceled",
                            "skipped"
                          ]
                        },
                        "reason": {
                          "enum": [
                            null,
                            "invalid_credentials",
                            "quota_exhausted",
                            "rate_limited",
                            "access_denied",
                            "region_restricted",
                            "policy_restricted",
                            "model_not_found_or_inaccessible",
                            "invalid_request",
                            "unsupported_operation",
                            "provider_unavailable",
                            "network_error",
                            "timeout",
                            "invalid_response",
                            "empty_response",
                            "unknown"
                          ]
                        },
                        "scope": {
                          "enum": [
                            "account",
                            "model",
                            "provider",
                            "region",
                            "request",
                            "client",
                            "unknown"
                          ]
                        },
                        "certainty": {
                          "enum": ["explicit", "inferred", "unknown"]
                        },
                        "source": {
                          "enum": ["provider_code", "http_status", "client_error"]
                        },
                        "classifierVersion": {
                          "const": "1"
                        },
                        "httpStatus": {
                          "type": "integer",
                          "minimum": 100,
                          "maximum": 599
                        },
                        "retry": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["action", "afterSeconds"],
                          "properties": {
                            "action": {
                              "enum": [
                                "none",
                                "check_credentials",
                                "check_billing",
                                "retry_later",
                                "check_limits",
                                "check_model_access",
                                "check_supported_locations",
                                "review_policy",
                                "check_model_id_and_access",
                                "check_operation",
                                "check_settings",
                                "check_network",
                                "review_response",
                                "review_diagnostics"
                              ]
                            },
                            "afterSeconds": {
                              "type": ["integer", "null"],
                              "minimum": 0,
                              "maximum": 604800
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "attempt": {
                      "properties": {
                        "outcome": {
                          "const": "succeeded"
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "checks": {
                      "properties": {
                        "textGeneration": {
                          "const": "passed"
                        },
                        "speed": {
                          "enum": ["passed", "not_run"]
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "attempt": {
                      "properties": {
                        "outcome": {
                          "const": "partial"
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "checks": {
                      "properties": {
                        "textGeneration": {
                          "const": "passed"
                        },
                        "speed": {
                          "enum": ["blocked", "inconclusive", "not_run"]
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "attempt": {
                      "properties": {
                        "outcome": {
                          "enum": ["blocked", "inconclusive"]
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "checks": {
                      "properties": {
                        "textGeneration": {
                          "enum": ["blocked", "inconclusive", "not_run"]
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["assessment"]
            },
            "then": {
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "assessment": {
                        "properties": {
                          "attempt": {
                            "properties": {
                              "outcome": {
                                "const": "succeeded"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "result": {
                        "const": "passed"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "result": {
                        "const": "failed"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "assessment": {
                        "properties": {
                          "checks": {
                            "properties": {
                              "speed": {
                                "not": {
                                  "const": "passed"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "required": ["tokensPerSecond"]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["offeringId", "source", "reviewedAt", "rationale"],
        "properties": {
          "offeringId": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "pattern": "^https://"
          },
          "reviewedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": ["schemaVersion", "providers", "models", "families", "offerings", "presets"],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "byokit catalog v1"
}
