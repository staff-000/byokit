  "identifierRules": [
    {
      "creatorId": "openai",
      "pattern": "^(?:gpt(?:-|\\d)|chatgpt-|o[134](?:-|$)|text-embedding-(?:3|ada)|dall-e-|tts-1(?:-|$)|whisper-1(?:$|-)|babbage-002$|davinci-002$|omni-moderation-|codex-)"
    },
    {
      "creatorId": "anthropic",
      "pattern": "^claude(?:-|\\d)"
    },
    {
      "creatorId": "google",
      "pattern": "^(?:gemini(?:-|\\d)|gemma(?:-|\\d)|imagen(?:-|\\d)|veo(?:-|\\d))"
    },
    {
      "creatorId": "deepseek",
      "pattern": "^deepseek(?:-|_|\\d)"
    },
    {
      "creatorId": "alibaba",
      "pattern": "^(?:qwen(?:-|\\d)|qwq(?:-|$)|qvq(?:-|$)|wan(?:-|\\d))"
    },
    {
      "creatorId": "zhipu",
      "pattern": "^(?:glm(?:-|\\d)|codegeex(?:-|\\d))"
    },
    {
      "creatorId": "xai",
      "pattern": "^grok(?:-|\\d)"
    },
    {
      "creatorId": "moonshot",
      "pattern": "^(?:kimi(?:-|$)|moonshot-v\\d)"
    },
    {
      "creatorId": "minimax",
      "pattern": "^(?:minimax(?:-|\\d)|abab\\d)"
    },
    {
      "creatorId": "meta",
      "pattern": "^llama(?:-|\\d)"
    },
    {
      "creatorId": "mistral",
      "pattern": "^(?:mistral(?:-|\\d)|ministral(?:-|\\d)|mixtral-|codestral-|devstral-|pixtral-|voxtral-|magistral-)"
    },
    {
      "creatorId": "bytedance",
      "pattern": "^(?:doubao-|seed(?:-|ance|ream))"
    },
    {
      "creatorId": "xiaomi",
      "pattern": "^mimo(?:-|\\d)"
    },
    {
      "creatorId": "stepfun",
      "pattern": "^step(?:-|\\d)"
    },
    {
      "creatorId": "cohere",
      "pattern": "^(?:command-|embed-(?:english|multilingual|v\\d)|rerank-(?:english|multilingual|v\\d))"
    },
    {
      "creatorId": "amazon",
      "pattern": "^nova-(?:micro|lite|pro|premier|sonic|canvas|reel)"
    },
    {
      "creatorId": "microsoft",
      "pattern": "^phi(?:-|\\d)"
    },
    {
      "creatorId": "nvidia",
      "pattern": "^nemotron(?:-|\\d)"
    },
    {
      "creatorId": "baidu",
      "pattern": "^ernie(?:-|\\d)"
    },
    {
      "creatorId": "perplexity",
      "pattern": "^sonar(?:-|$)"
    },
    {
      "creatorId": "openbmb",
      "pattern": "^minicpm(?:-|\\d)"
    },
    {
      "creatorId": "baai",
      "pattern": "^bge(?:-|_)"
    },
    {
      "creatorId": "alibaba",
      "pattern": "^tongyi-"
    }
  ],
  "providerTransforms": {
    "digitalocean": {
      "pattern": "^(openai|anthropic|alibaba|cohere)-(.+)$",
      "mode": "namespace"
    },
    "azure": {
      "pattern": "^(cohere)-(.+)$",
      "mode": "namespace"
    },
    "azure-cognitive-services": {
      "pattern": "^(cohere)-(.+)$",
      "mode": "namespace"
    },
    "cloudflare-workers-ai": {
      "pattern": "^@(?:cf|hf)/(.+)$",
      "mode": "identifier"
    }
  }
}
