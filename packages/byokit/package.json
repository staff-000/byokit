{
  "name": "byokit",
  "version": "0.2.2",
  "description": "Add BYOK with a model list and one simple call. Keep your model choices fresh.",
  "type": "module",
  "bin": {
    "byokit": "bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./catalog": {
      "types": "./catalog.d.ts",
      "default": "./catalog.js"
    },
    "./enums": {
      "types": "./enums.d.ts",
      "default": "./enums.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./dom": {
      "types": "./dom/index.d.ts",
      "default": "./dom/index.js"
    },
    "./dom/styles.css": "./dom/styles.css",
    "./dom/local": {
      "types": "./dom/local.d.ts",
      "default": "./dom/local.js"
    },
    "./react": {
      "types": "./react/index.d.ts",
      "default": "./react/index.js"
    },
    "./assets/manifest": "./assets/manifest.json",
    "./assets/*": "./assets/*"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "core.js",
    "core.d.ts",
    "client.js",
    "client.d.ts",
    "catalog.js",
    "catalog.d.ts",
    "enums.js",
    "enums.d.ts",
    "verification.js",
    "call.js",
    "connection.js",
    "sdk.js",
    "custom-model.js",
    "execution-model.js",
    "bin.mjs",
    "dom",
    "react",
    "assets",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/staff-000/byokit.git",
    "directory": "packages/byokit"
  },
  "homepage": "https://github.com/staff-000/byokit#readme",
  "bugs": {
    "url": "https://github.com/staff-000/byokit/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
