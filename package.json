{
  "name": "byokit-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/byokit"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:python": "python3 -m unittest discover -s packages/python/tests -v",
    "check": "node packages/byokit/bin.mjs check examples/byok.config.json",
    "catalog:import": "node scripts/import-catalog.mjs",
    "demo": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/browser-smoke.mjs",
    "build": "node packages/byokit/bin.mjs build examples/byok.config.json --out examples/generated/catalog.json",
    "enums:generate": "node scripts/generate-enums.mjs",
    "typecheck:python": "pyright --project pyrightconfig.json",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "node scripts/serve-site.mjs",
    "site:test": "node scripts/site-smoke.mjs",
    "verify": "node scripts/verify.mjs",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "check:budget": "node packages/byokit/bin.mjs check examples/task.config.json --strict",
    "lint": "eslint packages/ scripts/ website/ tests/ && prettier --check .",
    "lint:fix": "eslint packages/ scripts/ website/ tests/ --fix && prettier --write .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "pyright": "^1.1.414",
    "typescript": "^5.9.3"
  }
}
