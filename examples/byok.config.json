{
  "catalog": "../catalog/catalog.json",
  "preset": "global",
  "filters": {
    "input": { "contain": ["text"] },
    "output": { "exact": ["text"] },
    "deployment": { "exact": ["hosted"] }
  },
  "ui": {
    "maxProviders": 8,
    "maxModelsPerProvider": 4,
    "allowCustomModel": true
  },
  "budget": {
    "maxInputTokens": 2048,
    "maxOutputTokens": 1024,
    "overheadTokens": 256
  }
}
