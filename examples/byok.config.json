{
  "catalog": "../catalog/catalog.json",
  "preset": "non-china",
  "filters": {
    "input": [
      "text"
    ],
    "output": [
      "text"
    ],
    "deployment": [
      "hosted"
    ]
  },
  "ui": {
    "maxProviders": 8,
    "maxModelsPerProvider": 4,
    "allowCustomModel": true
  },
  "budget": {
    "maxInputTokens": 2048,
    "maxOutputTokens": 1024,
    "overheadTokens": 256
  }
}
