# byokit release credentials
# Copy this file to .env.release (which is in .gitignore and will NEVER be committed)
# Then fill in your tokens:

# 1. npm Access Token (classic or granular token with read/write access to @byokit)
# Get from: https://www.npmjs.com/settings/tokens
NPM_TOKEN=npm_your_token_here

# 2. PyPI API Token (starts with pypi-)
# Get from: https://pypi.org/manage/account/token/
PYPI_API_TOKEN=pypi-your_token_here
